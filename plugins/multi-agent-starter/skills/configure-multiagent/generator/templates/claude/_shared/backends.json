{
  "schema_version": "1",
  "flavor": "claude",
  "multiagent_root_env": "MULTIAGENT_ROOT",
  "workers": {
    "claude-main": {
      "model": "host-default",
      "call_type": "native",
      "native": { "subagent_type": "claude-main", "prompt_source": "brief", "model_alias": "claude-fable-5" },
      "approval_class": "worker",
      "result_capture": "orchestrator"
    },
    "codex-main": {
      "model": "codex-default",
      "call_type": "mcp",
      "mcp": {
        "tool": "mcp__codex__codex",
        "args_template": { "prompt": "@brief_content", "sandbox": "workspace-write", "approval-policy": "never" }
      },
      "brief_mode": "content",
      "cwd_policy": "task_dir",
      "approval_class": "worker",
      "result_capture": "tool-return",
      "timeout": 300,
      "fallbacks": [
        {
          "model": "codex-default", "call_type": "cli", "brief_mode": "stdin", "timeout": 300,
          "approval_class": "worker", "result_capture": "envelope", "cwd_policy": "task_dir",
          "cli": { "command": "codex", "args_template": ["exec", "--sandbox", "workspace-write", "-"],
                   "non_interactive": { "stdin": "brief", "no_tty": true, "on_permission_prompt": "fail" } }
        }
      ]
    },
    "codex-critic": {
      "model": "codex-default",
      "call_type": "mcp",
      "mcp": {
        "tool": "mcp__codex__codex",
        "args_template": { "prompt": "@brief_content", "sandbox": "read-only", "approval-policy": "never" }
      },
      "brief_mode": "content",
      "cwd_policy": "task_dir",
      "approval_class": "worker",
      "result_capture": "tool-return",
      "timeout": 300,
      "fallbacks": [
        {
          "model": "codex-default", "call_type": "cli", "brief_mode": "stdin", "timeout": 300,
          "approval_class": "worker", "result_capture": "envelope", "cwd_policy": "task_dir",
          "cli": { "command": "codex", "args_template": ["exec", "--sandbox", "read-only", "-"],
                   "non_interactive": { "stdin": "brief", "no_tty": true, "on_permission_prompt": "fail" } }
        }
      ]
    },
    "gemini": {
      "model": "gemini-3.6-flash-high",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "agy",
        "args_template": ["--model", "gemini-3.6-flash-high", "--prompt", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "isolated_tmp",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300,
      "fallbacks": [
        {
          "model": "gemini-3.6-flash-low", "call_type": "cli", "brief_mode": "content", "timeout": 300,
          "approval_class": "worker", "result_capture": "envelope",
          "cwd_policy": "isolated_tmp", "write_policy": "none",
          "cli": {
            "command": "agy",
            "args_template": ["--model", "gemini-3.6-flash-low", "--prompt", "@brief_content"],
            "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
          }
        },
        {
          "model": "gemini-api-flash-latest", "call_type": "api", "timeout": 300,
          "approval_class": "worker", "result_capture": "envelope",
          "api": { "ref": "adapters/gemini_api.sh", "required_env": ["GEMINI_API_KEY"],
                   "brief_pass": "arg1", "retry": { "max": 2, "backoff_s": 2 } }
        }
      ]
    }
  }
}
